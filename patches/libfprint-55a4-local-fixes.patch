+  ActivateNopRetry *retry = g_new0(ActivateNopRetry, 1);
+  retry->dev = g_object_ref(dev);
+  retry->ssm = ssm;
+  retry->error = error; // Ownership moves with the deferred retry.
+  g_idle_add(activate_nop_retry, retry);
