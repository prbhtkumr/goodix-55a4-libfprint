+typedef struct {
+  FpDevice *dev; // Strong ref, dropped when the idle source fires.
+  FpiSsm *ssm;
+  GError *error; // Original state-0 failure; consumed only on the error path.
+} ActivateNopRetry;
+
+static void activate_read_and_nop_done(FpDevice *dev, gpointer user_data,
+                                       GError *error);
+
+// Deferred retry: must run on the next main-loop iteration, never inline in
+// the callback. goodix_send_nop() always issues a trailing
+// goodix_receive_done() after goodix_send_protocol() returns; resetting or
+// re-sending synchronously here would race it, since the retried NOP's
+// completion advances the SSM first and the trailing call would then dispatch
+// the *next* state's callback before its reply arrived. By the time this
+// source runs, send_nop() and its trailing completion have unwound (the
+// write-failure path clears ack/reply, so that call was a no-op).
+static gboolean activate_nop_retry(gpointer user_data) {
+  ActivateNopRetry *retry = user_data;
+  g_autoptr(GError) reset_error = NULL;
+
+  if (g_usb_device_reset(fpi_device_get_usb_device(retry->dev),
+                         &reset_error)) {
+    fp_dbg("bulk-OUT was wedged by a USB suspend/resume cycle; reset the "
+           "device and retry the wake-up NOP");
+    g_clear_pointer(&retry->error, g_error_free);
+    goodix_send_nop(retry->dev, activate_read_and_nop_done, retry->ssm);
+  } else {
+    fp_warn("wake-up reset failed: %s", reset_error->message);
+    fpi_ssm_mark_failed(retry->ssm, retry->error);
+    retry->error = NULL;
+  }
+
+  g_object_unref(retry->dev);
+  g_free(retry);
+  return G_SOURCE_REMOVE;
