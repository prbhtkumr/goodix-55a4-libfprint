+static void
+goodix_reimage_tls_ready (FpDevice *dev, gpointer user_data, GError *error)
+{
+  FpiDeviceGoodixTls *self = FPI_DEVICE_GOODIXTLS (dev);
+  FpiDeviceGoodixTlsPrivate *priv =
+    fpi_device_goodixtls_get_instance_private (self);
+  GoodixCmdCallback cb = priv->reimage_callback;
+  gpointer ud = priv->reimage_user_data;
+  GoodixDefault payload = {.unused_flags = 0x01};
+
+  priv->reimage_callback = NULL;
+  priv->reimage_user_data = NULL;
+
+  if (error)
+    {
+      if (cb)
+        cb (dev, NULL, 0, ud, error);
+      return;
+    }
+
+  fp_dbg ("TLS re-established; retrying GET_IMAGE");
+  goodix_send_protocol (dev, GOODIX_CMD_MCU_GET_IMAGE, (guint8 *) &payload,
+                        sizeof (payload), NULL, TRUE, GOODIX_TIMEOUT, TRUE,
+                        cb, ud);
