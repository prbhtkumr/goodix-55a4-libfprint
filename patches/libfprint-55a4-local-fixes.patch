+
+// Completion of the state-0 NOP (also the completion of its one retry). On
+// error, ownership of the GError transfers with the path taken below.
+static void activate_read_and_nop_done(FpDevice *dev, gpointer user_data,
+                                       GError *error) {
+  FpiDeviceGoodixTls55X4 *self = FPI_DEVICE_GOODIXTLS55X4(dev);
+  FpiSsm *ssm = user_data;
+
+  if (!error) {
+    fpi_ssm_next_state(ssm);
+    return;
+  }
+
+  if (self->nop_wake_tried) {
+    // The retried NOP (sent after the wake-reset in the idle source) failed
+    // as well: give up with this error rather than looping. A failed reset
+    // completes the SSM straight from the idle source instead.
+    fpi_ssm_mark_failed(ssm, error);
+    return;
+  }
